# The playground's key, sent for anonymous callers on the default backend
# (server/plugins/proxy-apikey.ts).
NUXT_PROXY_APIKEY=your-transitland-api-key
# Proxy backends: NUXT_TLV2PROXY_BACKENDS_<NAME>_BASE. The `default` backend also
# serves the /auth/session `me` enrichment.
# NUXT_TLV2PROXY_BACKENDS_DEFAULT_BASE=https://api.transit.land/api/v2

NUXT_AUTH0_AUDIENCE=https://your-audience.example.com
NUXT_AUTH0_CLIENT_ID=your-auth0-client-id
NUXT_AUTH0_CLIENT_SECRET=your-auth0-client-secret
NUXT_AUTH0_DOMAIN=your-tenant.auth0.com
NUXT_AUTH0_SESSION_SECRET=a-random-string-at-least-32-chars-long
NUXT_AUTH0_APP_BASE_URL=http://localhost:3000
