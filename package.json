{
  "name": "@interline-io/tlv2-auth",
  "version": "0.0.0",
  "repository": "https://github.com/interline-io/tlv2-auth",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@10.21.0",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./composables": {
      "types": "./dist/runtime/composables/index.d.ts",
      "import": "./dist/runtime/composables/index.js"
    },
    "./proxy-route": {
      "types": "./dist/runtime/util/proxy-route.d.ts",
      "import": "./dist/runtime/util/proxy-route.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "pnpm --filter playground dev",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare",
    "lint": "eslint .",
    "check": "pnpm lint --fix && pnpm nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "peerDependencies": {
    "h3": "^1.0.0",
    "nuxt": "^4.0.0",
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@auth0/auth0-nuxt": "^1.0.1",
    "defu": "^6.1.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "^4.5.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "eslint-typegen": "2.3.1",
    "nuxi": "3.37.0",
    "nuxt": "^4.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11",
    "vue": "^3.5.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "unrs-resolver",
      "vue-demi"
    ]
  }
}
